<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test harness for the Unity-independent Core code. Lives outside Assets/ so Unity ignores it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Core/Levels/*.cs" Exclude="../../Assets/_Project/Scripts/Core/Levels/LevelCatalog.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Board/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Queue/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Conveyor/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Shooting/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Holder/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/Hint/*.cs" />
  </ItemGroup>
</Project>
